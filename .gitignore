# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv venv (heavy, local)
.venv/
# .python-version is committed on purpose - pins the interpreter for reproducibility

# Pytest / linters / type checkers
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code per-user, per-machine settings
.claude/settings.local.json
CLAUDE.local.md

# Superpowers SDD scratch (briefs, reports, review packages, progress ledger)
.superpowers/
# Design specs and plans are process artifacts, not documentation. Anything an outside
# reader needs is promoted into its own document under docs/ instead.
docs/superpowers/

# Secrets: application credentials and OAuth tokens never belong in git
.env
.env.*
!.env.example
*.pem
secrets/
tokens/

# Generated protobuf bindings are COMMITTED on purpose, so that installing from git
# needs no protoc toolchain. Regenerate with scripts/gen_protobuf.py; never hand-edit.

# Logs
logs/
*.log

# Recordings captured from a live broker before scrubbing.
# Only scrubbed fixtures under tests/fixtures/ may be committed.
tests/recordings/
